---
import { CONTACT } from '../data/contact';
interface Props {
  id?: string;
}

const { id = 'newsletter' } = Astro.props;
const interests = ['Diseño web', 'Tecnología y automatización', 'Noticias y novedades'];
---

<section class="newsletter-section section" id={id} aria-labelledby={`${id}-title`}>
  <div class="container newsletter-panel">
    <div class="newsletter-copy">
      <p class="eyebrow">
        <span class="newsletter-spark" aria-hidden="true">✦</span> El boletín de Altum
      </p>
      <h2 id={`${id}-title`}>Buenas ideas,<br /><span>en tu bandeja.</span></h2>
      <p class="newsletter-intro">
        Guías para mejorar tu presencia digital, tecnología que vale la pena conocer y novedades de
        Altum. Una nueva perspectiva para tu próximo paso.
      </p>

      <div class="newsletter-preview" aria-hidden="true">
        <div class="newsletter-edition">
          <div class="edition-heading">
            <span>ALTUM / IDEAS DIGITALES</span><svg
              width="22"
              height="22"
              viewBox="0 0 24 24"
              fill="none"
              ><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.5"></path></svg
            >
          </div>
          <div class="edition-content">
            <div class="edition-art"><span></span><span></span><span></span></div>
            <div>
              <small>UNA IDEA PARA TU NEGOCIO</small><strong
                >Tu siguiente<br />gran paso empieza<br />con una buena idea.</strong
              >
            </div>
          </div>
          <div class="edition-bottom">
            <span>Diseño. Tecnología. Posibilidades.</span><span>↗</span>
          </div>
        </div>
        <div class="newsletter-delivery">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none"
            ><rect
              x="3"
              y="5"
              width="18"
              height="14"
              rx="3"
              stroke="currentColor"
              stroke-width="1.5"></rect><path
              d="m4 7 8 6 8-6"
              stroke="currentColor"
              stroke-width="1.5"></path></svg
          ><span>Ideas que conectan.</span><i></i>
        </div>
      </div>
    </div>

    <form
      class="newsletter-form"
      action={`https://formsubmit.co/${CONTACT.email}`}
      method="POST"
      data-email-form
      aria-labelledby={`${id}-form-title`}
      aria-describedby={`${id}-delivery-note`}
    >
      <input type="hidden" name="_subject" value="[Altum Newsletter] Solicitud de suscripción" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://www.altumlapaz.com/gracias/newsletter/" />
      <input type="hidden" name="Origen" value={`Altum · ${id}`} />
      <input
        type="hidden"
        name="Aviso de privacidad"
        value="https://www.altumlapaz.com/privacidad/#newsletter · 2026-09-18"
      />
      <input type="hidden" name="Fecha de solicitud" value="" data-submission-date />
      <div class="newsletter-trap" aria-hidden="true">
        <label for={`${id}-website`}>Deja este campo vacío</label>
        <input id={`${id}-website`} type="text" name="_honey" tabindex="-1" autocomplete="off" />
      </div>

      <div class="newsletter-form-heading">
        <h3 id={`${id}-form-title`}>Un lugar para seguir aprendiendo.</h3>
        <p>
          Cuéntanos qué te interesa. El correo es obligatorio; tu nombre y tus intereses son
          opcionales.
        </p>
      </div>

      <div class="newsletter-fields">
        <label class="newsletter-field" for={`${id}-name`}>
          Tu nombre <span class="optional">Opcional</span>
          <input
            id={`${id}-name`}
            type="text"
            name="nombre"
            autocomplete="given-name"
            maxlength="80"
            placeholder="¿Cómo te llamas?"
          />
        </label>
        <label class="newsletter-field" for={`${id}-email`}>
          Correo electrónico <span class="required" aria-hidden="true">*</span>
          <input
            id={`${id}-email`}
            type="email"
            name="email"
            autocomplete="email"
            inputmode="email"
            maxlength="254"
            placeholder="tu@correo.com"
            required
          />
        </label>
      </div>

      <fieldset class="newsletter-interests">
        <legend>Me interesa <span class="optional">Opcional</span></legend>
        <div class="interest-options">
          {
            interests.map((interest, index) => (
              <label class="interest-choice" for={`${id}-interest-${index}`}>
                <input
                  id={`${id}-interest-${index}`}
                  type="checkbox"
                  name={`Interes ${index + 1}`}
                  value={interest}
                />
                <span>{interest}</span>
              </label>
            ))
          }
        </div>
      </fieldset>

      <label class="newsletter-consent" for={`${id}-consent`}>
        <input
          id={`${id}-consent`}
          type="checkbox"
          name="consentimiento_newsletter"
          value="Sí, autorizo recibir por correo guías, noticias, novedades y comunicaciones de marketing de Altum. Puedo solicitar mi baja cuando quiera."
          aria-describedby={`${id}-privacy-note`}
          required
        />
        <span
          >Quiero recibir por correo guías, noticias, novedades y comunicaciones de marketing de
          Altum.</span
        >
      </label>
      <p class="newsletter-privacy" id={`${id}-privacy-note`}>
        Puedes darte de baja cuando quieras escribiendo a
        <a href={`${CONTACT.emailHref}?subject=Baja%20de%20newsletter`}>{CONTACT.email}</a>.
        Consulta el <a href="/privacidad/#newsletter">aviso de privacidad</a>.
      </p>

      <button
        type="submit"
        class="button newsletter-submit"
        data-submit-label="Quiero recibir el boletín"
      >
        <span>Quiero recibir el boletín</span>
        <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none"
          ><path
            d="M4 12h16m-6-6 6 6-6 6"
            stroke="currentColor"
            stroke-width="1.7"
            stroke-linecap="round"
            stroke-linejoin="round"></path></svg
        >
      </button>
      <p class="newsletter-delivery-note" id={`${id}-delivery-note`}>
        Al continuar completarás la validación de seguridad. Tu solicitud llegará a nuestro correo
        para gestionar tu suscripción.
      </p>
      <p class="newsletter-delivery-note" role="status" aria-live="polite" data-form-status></p>
    </form>
  </div>
</section>

<script>
  import { enhanceEmailForms } from '../lib/email-forms';
  enhanceEmailForms();
</script>

<style>
  .newsletter-section {
    padding-top: 65px;
  }
  .newsletter-panel {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 1fr 1.04fr;
    gap: clamp(30px, 5vw, 70px);
    padding: clamp(26px, 4.5vw, 60px);
    border: 1px solid #354564;
    border-radius: 28px;
    background:
      radial-gradient(ellipse at 0% 0%, #244d713d, transparent 50%),
      radial-gradient(ellipse at 90% 100%, #53399824, transparent 50%), #0c1522;
    box-shadow: 0 25px 80px #0000001f;
  }
  .newsletter-panel::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: linear-gradient(90deg, transparent, #28d2e7b0, #9276ff90, transparent);
  }
  .newsletter-copy,
  .newsletter-form {
    min-width: 0;
  }
  .newsletter-copy .eyebrow {
    color: #abc7e6;
  }
  .newsletter-spark {
    color: var(--cyan);
    margin-right: 9px;
  }
  .newsletter-copy h2 {
    font-size: clamp(2.2rem, 3.6vw, 3.35rem);
    line-height: 1.12;
  }
  .newsletter-copy h2 span {
    color: #8bcaff;
  }
  .newsletter-intro {
    margin-top: 22px;
    font-size: 0.94rem;
    max-width: 440px;
  }
  .newsletter-preview {
    position: relative;
    padding: 34px 20px 27px 0;
    max-width: 430px;
  }
  .newsletter-edition {
    transform: rotate(-3deg);
    border: 1px solid #425573;
    padding: 23px;
    border-radius: 14px;
    background: linear-gradient(140deg, #1d3048, #131d32 80%);
    box-shadow: 0 20px 40px #0004;
  }
  .edition-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-bottom: 19px;
    border-bottom: 1px solid #637a9b40;
    color: #bcd3eb;
    font-size: 0.59rem;
    letter-spacing: 0.14em;
  }
  .edition-heading svg {
    color: var(--cyan);
  }
  .edition-content {
    display: grid;
    grid-template-columns: 90px 1fr;
    gap: 22px;
    align-items: center;
    padding-block: 22px;
  }
  .edition-content small {
    display: block;
    font-size: 0.48rem;
    letter-spacing: 0.1em;
    color: #9cacc7;
    margin-bottom: 10px;
  }
  .edition-content strong {
    font:
      500 clamp(1.1rem, 1.8vw, 1.55rem)/1.18 'Space Grotesk Variable',
      sans-serif;
    letter-spacing: -0.025em;
  }
  .edition-art {
    position: relative;
    height: 118px;
  }
  .edition-art span {
    position: absolute;
    width: 65px;
    height: 65px;
    border: 1px solid #76f1fb6e;
    border-radius: 16px;
    transform: rotate(-15deg);
    background: linear-gradient(135deg, #28d2e742, #478aff12);
    box-shadow: inset 0 0 15px #28d2e71a;
  }
  .edition-art span:nth-child(1) {
    top: 1px;
    left: 5px;
  }
  .edition-art span:nth-child(2) {
    top: 27px;
    left: 18px;
    border-color: #799bff8c;
    background: linear-gradient(135deg, #5992ec60, #5572d218);
  }
  .edition-art span:nth-child(3) {
    top: 51px;
    left: 29px;
    border-color: #b6a1ff8c;
    background: linear-gradient(135deg, #9b7be36e, #666ec23b);
    animation: newsletter-card-drift 7s ease-in-out infinite;
  }
  .edition-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding-top: 15px;
    border-top: 1px solid #637a9b40;
    font-size: 0.6rem;
    color: #a5b8ce;
  }
  .edition-bottom > span:last-child {
    font-size: 1rem;
    color: #96d6ec;
  }
  .newsletter-delivery {
    position: absolute;
    right: 0;
    bottom: 9px;
    display: flex;
    gap: 12px;
    align-items: center;
    border: 1px solid #446477;
    border-radius: 10px;
    padding: 13px 17px;
    color: #d5e7f5;
    background: #142639;
    box-shadow: 0 12px 25px #0004;
    font-size: 0.72rem;
  }
  .newsletter-delivery svg {
    color: #84d9e6;
  }
  .newsletter-delivery i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #70efc6;
  }
  .newsletter-form {
    padding-top: 4px;
  }
  .newsletter-form-heading h3 {
    font-size: 1.38rem;
    line-height: 1.3;
    letter-spacing: -0.035em;
  }
  .newsletter-form-heading p {
    margin-top: 10px;
    font-size: 0.8rem;
    line-height: 1.7;
  }
  .newsletter-fields {
    display: grid;
    grid-template-columns: 1fr;
    gap: 17px;
    margin-top: 25px;
  }
  .newsletter-field {
    display: block;
    color: #dce6f4;
    font-size: 0.81rem;
    font-weight: 600;
  }
  .optional {
    margin-left: 7px;
    font-size: 0.7rem;
    color: #a1b2c8;
    font-weight: 400;
  }
  .required {
    color: #8ebeff;
  }
  .newsletter-field input {
    display: block;
    width: 100%;
    min-height: 49px;
    margin-top: 9px;
    border: 1px solid #394b67;
    border-radius: 9px;
    padding: 13px 15px;
    background: #090f1bcc;
    color: #f0f6ff;
    font-size: 0.94rem;
    transition:
      border-color 0.2s,
      box-shadow 0.2s;
  }
  .newsletter-field input::placeholder {
    color: #8596af;
    opacity: 1;
  }
  .newsletter-field input:focus {
    border-color: #72c6e2;
    box-shadow: 0 0 0 3px #28d2e714;
  }
  .newsletter-interests {
    border: 0;
    padding: 0;
    margin: 23px 0 17px;
    min-width: 0;
  }
  .newsletter-interests legend {
    padding: 0;
    margin-bottom: 10px;
    color: #dce6f4;
    font-size: 0.81rem;
    font-weight: 600;
  }
  .interest-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .interest-choice {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 12px;
    border: 1px solid #334660;
    border-radius: 9px;
    background: #101c2d;
    color: #bccce1;
    font-size: 0.73rem;
    cursor: pointer;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .interest-choice:has(input:checked) {
    border-color: #72bcda;
    color: #dff7ff;
    background: #14314b;
  }
  .interest-choice:has(input:focus-visible) {
    outline: 3px solid var(--cyan);
    outline-offset: 3px;
  }
  .interest-choice input,
  .newsletter-consent input {
    flex: 0 0 auto;
    margin: 0;
    width: 16px;
    height: 16px;
    accent-color: #65d3ea;
    cursor: pointer;
  }
  .newsletter-consent {
    display: flex;
    align-items: flex-start;
    gap: 11px;
    min-height: 44px;
    padding-block: 7px;
    color: #c6d6ea;
    font-size: 0.76rem;
    line-height: 1.65;
    cursor: pointer;
  }
  .newsletter-consent input {
    margin-top: 3px;
  }
  .newsletter-privacy {
    font-size: 0.71rem;
    line-height: 1.75;
    margin: 7px 0 22px 27px;
  }
  .newsletter-privacy a {
    color: #addef4;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  .newsletter-privacy a:hover {
    color: #e8f9ff;
  }
  .newsletter-submit {
    width: 100%;
    min-height: 52px;
    justify-content: space-between;
    text-align: left;
    background: linear-gradient(110deg, #155b91, #365ac6 65%, #6343af);
    border-color: #739dd570;
    box-shadow: inset 0 1px 0 #ffffff18;
  }
  .newsletter-submit svg {
    flex: 0 0 auto;
  }
  .newsletter-delivery-note {
    margin-top: 13px;
    font-size: 0.71rem;
    line-height: 1.7;
    color: #99adc7;
  }
  .newsletter-trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  @keyframes newsletter-card-drift {
    50% {
      translate: 0 -5px;
    }
  }
  :global(html[data-motion='paused']) .edition-art span {
    animation-play-state: paused;
  }
  @media (max-width: 960px) {
    .newsletter-panel {
      gap: 35px;
    }
    .edition-content {
      grid-template-columns: 70px 1fr;
      gap: 12px;
    }
    .edition-art {
      transform: scale(0.8);
      transform-origin: left center;
    }
    .newsletter-edition {
      padding: 18px;
    }
  }
  @media (max-width: 760px) {
    .newsletter-section {
      padding-top: 30px;
    }
    .newsletter-panel {
      grid-template-columns: 1fr;
      gap: 26px;
      padding: 28px 22px;
      border-radius: 22px;
    }
    .newsletter-copy h2 {
      font-size: clamp(2.2rem, 8vw, 3.2rem);
    }
    .newsletter-intro {
      font-size: 0.91rem;
      max-width: 520px;
    }
    .newsletter-preview {
      max-width: 370px;
      margin-top: 7px;
      padding-top: 20px;
    }
    .newsletter-edition {
      transform: rotate(-2deg);
    }
    .edition-content {
      grid-template-columns: 75px 1fr;
      padding-block: 16px;
    }
    .edition-content strong {
      font-size: 1.32rem;
    }
    .newsletter-form {
      padding-top: 25px;
      border-top: 1px solid #354660;
    }
    .newsletter-field input {
      font-size: 1rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .edition-art span {
      animation: none;
    }
    .newsletter-field input,
    .interest-choice {
      transition: none;
    }
  }
</style>
