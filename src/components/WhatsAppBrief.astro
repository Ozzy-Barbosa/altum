---
import { CONTACT } from '../data/contact';
import { projectTypes } from '../data/project-types';
---

<section
  class="container compact-section whatsapp-section"
  id="whatsapp"
  aria-labelledby="whatsapp-title"
>
  <div class="whatsapp-panel">
    <div class="whatsapp-copy">
      <span class="whatsapp-symbol" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none"
          ><path d="M27 15.5A11.5 11.5 0 0 1 10 25.6L4 27l1.5-5.8A11.5 11.5 0 1 1 27 15.5Z"
          ></path><path d="m11 10 2 4-1.5 1.5a12 12 0 0 0 5 5L18 19l4 2"></path></svg
        >
      </span>
      <p class="eyebrow">TU IDEA, EN UNA CONVERSACIÓN</p>
      <h2 id="whatsapp-title">¿Lo hablamos<br /><span>por WhatsApp?</span></h2>
      <p>
        Cuéntanos lo esencial. Preparamos un mensaje con tu idea para conversar directamente con
        Altum.
      </p>
      <ul>
        <li>Sin necesidad de dejar tu correo.</li>
        <li>Revisa tu resumen antes de compartirlo.</li>
        <li>Tú confirmas el envío dentro de WhatsApp.</li>
      </ul>
      <a class="text-link" href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer"
        >Prefiero escribir directamente <span aria-hidden="true">↗</span></a
      >
      <small>{CONTACT.phone}</small>
    </div>
    <form
      id="whatsapp-brief"
      class="whatsapp-form"
      action={CONTACT.whatsapp}
      method="GET"
      aria-describedby="whatsapp-help"
    >
      <fieldset disabled data-whatsapp-fields>
        <legend>Prepara tu consulta</legend>
        <p id="whatsapp-help">
          Los campos con * son obligatorios. No incluyas información sensible.
        </p>
        <div class="form-grid">
          <label class="field"
            >Tu nombre *<input
              id="wa-name"
              required
              maxlength="80"
              autocomplete="name"
              placeholder="¿Cómo te llamas?"
            /></label
          >
          <label class="field"
            >Negocio o marca (opcional)<input
              id="wa-business"
              maxlength="100"
              autocomplete="organization"
              placeholder="Nombre de tu negocio"
            /></label
          >
          <label class="field full"
            >¿Qué te gustaría crear? *<select id="wa-project" required>
              <option value="">Elige un tipo de proyecto</option>
              {projectTypes.map((p) => <option value={p.value}>{p.label}</option>)}
            </select></label
          >
          <label class="field full"
            >Cuéntanos tu idea *<textarea
              id="wa-goal"
              required
              minlength="15"
              maxlength="1000"
              rows="4"
              placeholder="Quiero una aplicación para organizar las citas, clientes y servicios de mi negocio…"
              aria-describedby="wa-goal-help"></textarea><small id="wa-goal-help"
              >Entre 15 y 1,000 caracteres.</small
            ></label
          >
        </div>
        <label class="consent-row whatsapp-consent"
          ><input id="wa-consent" type="checkbox" required /><span
            >Acepto que Altum use mis datos para responder mi solicitud y dar seguimiento a mi
            proyecto. He leído el <a href="/privacidad/#contacto">aviso de privacidad</a>. *</span
          ></label
        >
        <button type="submit" class="button whatsapp-prepare"
          >Preparar mensaje <span aria-hidden="true">↗</span></button
        >
      </fieldset>
      <noscript
        ><p class="whatsapp-noscript">
          Activa JavaScript para preparar el resumen o <a href={CONTACT.whatsapp}
            >abre WhatsApp y escríbenos directamente</a
          >. El formulario por correo también está disponible más arriba.
        </p></noscript
      >
      <p class="whatsapp-status" role="status" aria-live="polite" data-whatsapp-status></p>
      <div class="whatsapp-preview" data-whatsapp-preview hidden>
        <h3 tabindex="-1" data-whatsapp-preview-heading>Tu mensaje está listo para revisar.</h3>
        <p class="whatsapp-message" data-whatsapp-message></p>
        <a class="button whatsapp-open" data-whatsapp-link target="_blank" rel="noopener noreferrer"
          >Abrir WhatsApp <span aria-hidden="true">↗</span></a
        >
        <p>
          No se ha enviado todavía. En WhatsApp puedes editarlo y pulsar Enviar. Esta consulta no te
          suscribe al newsletter.
        </p>
      </div>
    </form>
  </div>
</section>

<script>
  import { buildWhatsAppBrief } from '../lib/whatsapp-brief';
  const form = document.querySelector<HTMLFormElement>('#whatsapp-brief');
  if (form) {
    const fields = form.querySelector<HTMLFieldSetElement>('[data-whatsapp-fields]')!;
    const name = form.querySelector<HTMLInputElement>('#wa-name')!;
    const business = form.querySelector<HTMLInputElement>('#wa-business')!;
    const project = form.querySelector<HTMLSelectElement>('#wa-project')!;
    const goal = form.querySelector<HTMLTextAreaElement>('#wa-goal')!;
    const consent = form.querySelector<HTMLInputElement>('#wa-consent')!;
    const preview = form.querySelector<HTMLElement>('[data-whatsapp-preview]')!;
    const status = form.querySelector<HTMLElement>('[data-whatsapp-status]')!;
    const link = form.querySelector<HTMLAnchorElement>('[data-whatsapp-link]')!;
    const param = new URLSearchParams(location.search).get('solucion');
    if (param && Array.from(project.options).some((option) => option.value === param))
      project.value = param;
    const invalidateDraft = () => {
      preview.hidden = true;
      link.removeAttribute('href');
      status.textContent = '';
      [name, business, goal].forEach((input) => input.setCustomValidity(''));
    };
    form.addEventListener('input', invalidateDraft);
    form.addEventListener('change', invalidateDraft);
    form.addEventListener('reset', invalidateDraft);
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      name.value = name.value.trim();
      business.value = business.value.trim();
      goal.value = goal.value.trim();
      name.setCustomValidity(name.value ? '' : 'Escribe tu nombre.');
      goal.setCustomValidity(
        goal.value.length < 15 ? 'Describe tu idea con al menos 15 caracteres.' : '',
      );
      if (!form.reportValidity()) return;
      try {
        const draft = buildWhatsAppBrief({
          name: name.value,
          business: business.value,
          project: project.selectedOptions[0].text,
          goal: goal.value,
          consent: consent.checked,
        });
        form.querySelector<HTMLElement>('[data-whatsapp-message]')!.textContent = draft.message;
        link.href = draft.url;
        preview.hidden = false;
        form.querySelector<HTMLElement>('[data-whatsapp-preview-heading]')!.focus();
      } catch (error) {
        status.textContent =
          error instanceof Error
            ? error.message
            : 'No se pudo preparar el mensaje. Puedes escribirnos directamente.';
      }
    });
    fields.disabled = false;
  }
</script>

<style>
  .whatsapp-section {
    scroll-margin-top: 110px;
  }
  .whatsapp-panel {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(30px, 5vw, 72px);
    padding: clamp(24px, 4vw, 50px);
    border: 1px solid #40726480;
    border-radius: 26px;
    background: radial-gradient(ellipse at top left, #25685328, transparent 50%), #0d1922;
  }
  .whatsapp-copy,
  .whatsapp-form {
    min-width: 0;
  }
  .whatsapp-symbol {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 24px;
    border-radius: 17px;
    border: 1px solid #72dcb256;
    background: #39795e22;
    color: #8ae3bd;
  }
  .whatsapp-symbol svg {
    width: 34px;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .whatsapp-copy .eyebrow {
    color: #a3cdbb;
  }
  .whatsapp-copy h2 {
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    margin-bottom: 20px;
  }
  .whatsapp-copy h2 span {
    color: #8ae3bd;
  }
  .whatsapp-copy > p:not(.eyebrow) {
    font-size: 0.94rem;
    max-width: 420px;
  }
  .whatsapp-copy ul {
    padding-left: 20px;
    margin-block: 26px;
    color: #bdd0ca;
    font-size: 0.84rem;
    line-height: 1.9;
  }
  .whatsapp-copy li::marker {
    color: #8ae3bd;
  }
  .whatsapp-copy .text-link {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    font-size: 0.83rem;
  }
  .whatsapp-copy > small {
    display: block;
    color: #a4bcb3;
    font-size: 0.78rem;
  }
  .whatsapp-form fieldset {
    min-width: 0;
    padding: 0;
    margin: 0;
    border: 0;
  }
  .whatsapp-form legend {
    font:
      500 1.4rem 'Space Grotesk Variable',
      sans-serif;
    margin-bottom: 8px;
  }
  #whatsapp-help {
    font-size: 0.78rem;
    margin-bottom: 23px;
  }
  .whatsapp-form .field {
    font-size: 0.8rem;
    gap: 8px;
    min-width: 0;
  }
  .whatsapp-form .field small {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .whatsapp-form input:not([type='checkbox']),
  .whatsapp-form textarea,
  .whatsapp-form select {
    background: #08121b;
    border-color: #3d564f;
    font-size: 0.9rem;
  }
  .whatsapp-form ::placeholder {
    color: #94a99f;
    opacity: 1;
  }
  .whatsapp-form input:focus,
  .whatsapp-form textarea:focus,
  .whatsapp-form select:focus {
    border-color: #8ae3bd;
    outline-color: #8ae3bd;
  }
  .whatsapp-consent {
    margin-top: 24px;
    color: #c5d6cf;
  }
  .whatsapp-consent input {
    accent-color: #76d7ac;
  }
  .whatsapp-consent a,
  .whatsapp-noscript a {
    color: #a2efce;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .whatsapp-prepare,
  .whatsapp-open {
    margin-top: 22px;
    width: 100%;
    justify-content: space-between;
    gap: 12px;
    background: #226347;
    border-color: #70c99770;
  }
  .whatsapp-prepare:hover,
  .whatsapp-open:hover {
    background: #2b7757;
  }
  .whatsapp-status {
    margin-top: 12px;
    font-size: 0.85rem;
    color: #c9f3db;
  }
  .whatsapp-status:empty {
    display: none;
  }
  .whatsapp-preview {
    margin-top: 28px;
    padding: 24px;
    border: 1px solid #6aac8d66;
    border-radius: 18px;
    background: #132b23;
  }
  .whatsapp-preview[hidden] {
    display: none;
  }
  .whatsapp-preview h3 {
    font-size: 1.15rem;
  }
  .whatsapp-message {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    font-size: 0.84rem;
    color: #d1e2d8;
    margin-top: 16px;
  }
  .whatsapp-preview > p:last-child,
  .whatsapp-noscript {
    font-size: 0.74rem;
    line-height: 1.8;
    margin-top: 14px;
  }
  @media (max-width: 960px) {
    .whatsapp-panel {
      grid-template-columns: 1fr;
    }
    .whatsapp-copy {
      max-width: 600px;
    }
  }
  @media (max-width: 600px) {
    .whatsapp-form .form-grid {
      grid-template-columns: 1fr;
    }
    .whatsapp-form input:not([type='checkbox']),
    .whatsapp-form select,
    .whatsapp-form textarea {
      font-size: 1rem;
    }
  }
  @media (max-width: 390px) {
    .whatsapp-panel {
      padding: 24px 18px;
    }
    .whatsapp-preview {
      padding: 18px 14px;
    }
  }
</style>
