---
import type { projects } from '../data/catalog';
interface Props {
  project: (typeof projects)[number];
}
const { project: p } = Astro.props;
---

<article class="project-card reveal">
  <a
    class="project-image project-image-complete"
    href={`/proyectos/${p.slug}/`}
    tabindex="-1"
    aria-hidden="true"
    ><span class="project-preview-bar"
      ><span class="preview-dots"><i></i><i></i><i></i></span><span>VISTA DEL PROYECTO</span><span
        >↗</span
      ></span
    ><span class="project-preview-screen"
      ><img
        src={`/assets/${p.image}`}
        alt=""
        width={p.imageWidth ?? 1440}
        height={p.imageHeight ?? 900}
        loading="lazy"
        decoding="async"
      /></span
    ></a
  ><div class="project-info">
    <div>
      <p class="eyebrow">
        {p.sector}
        <span
          class:list={[
            'project-status',
            {
              'in-progress': p.status.toLowerCase().includes('desarrollo'),
              'in-review': p.status.toLowerCase().includes('revisión'),
            },
          ]}><i class="status-dot"></i>{p.status}</span
        >
      </p><h3>
        <a href={`/proyectos/${p.slug}/`}>{p.name}</a>
      </h3>
    </div><a
      class="circle-link"
      href={`/proyectos/${p.slug}/`}
      aria-label={`Ver caso${p.progress ? ' y avance' : ''} de ${p.name}`}>↗</a
    >
  </div><p>{p.intro}</p>
  {p.statusNote && <p class="project-note">{p.statusNote}</p>}
  <div class="project-actions">
    {
      p.url && (
        <a
          class="text-link project-public-link"
          href={p.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visitar el sitio de ${p.name} (abre otra pestaña)`}
        >
          {p.progress ? 'Explorar versión pública' : 'Visitar sitio'}{' '}
          <span aria-hidden="true">↗</span>
        </a>
      )
    }
    {
      p.progress && (
        <a class="text-link project-progress-link" href={`/proyectos/${p.slug}/#avance`}>
          Ver avance <span aria-hidden="true">→</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .project-card {
    height: 100%;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .project-image-complete {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    aspect-ratio: auto;
    flex-shrink: 0;
    padding: 0;
    background: linear-gradient(145deg, #17283a, #0b1726);
    transition:
      border-color 350ms,
      box-shadow 350ms;
  }
  .project-preview-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 18px;
    color: #a9bfd7;
    font-size: 0.58rem;
    letter-spacing: 0.16em;
    border-bottom: 1px solid #ffffff0d;
  }
  .preview-dots {
    display: flex;
    gap: 5px;
  }
  .preview-dots i {
    width: 5px;
    height: 5px;
    background: #7293b3;
    border-radius: 50%;
  }
  .project-preview-screen {
    display: flex;
    padding: 16px;
    aspect-ratio: 1.5;
    min-width: 0;
  }
  .project-image-complete img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    border-radius: 8px;
    transform: none;
  }
  .project-image-complete::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(110deg, transparent 35%, #c0ebff12 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 900ms ease;
  }
  .project-card:focus-within .project-image-complete {
    border-color: #71b8df;
    box-shadow:
      0 18px 45px #0003,
      0 0 25px #168dff0d;
  }
  .project-card:focus-within .project-image-complete::after {
    transform: translateX(120%);
  }
  @media (hover: hover) and (pointer: fine) {
    .project-card:hover .project-image-complete {
      border-color: #71b8df;
      box-shadow:
        0 18px 45px #0003,
        0 0 25px #168dff0d;
    }
    .project-card:hover .project-image-complete::after {
      transform: translateX(120%);
    }
  }
  .project-info .eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .project-status {
    margin-left: 0;
  }
  .in-review .status-dot {
    background: #e6bc75;
    color: #e6bc75;
    box-shadow: 0 0 12px #e6bc7540;
  }
  .project-card > .project-note {
    color: #c4cfe0;
    font-size: 0.8rem;
    line-height: 1.7;
    padding-left: 12px;
    border-left: 2px solid #e6bc7570;
  }
  .project-public-link {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 0;
  }
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 18px 24px;
    align-items: center;
    margin-top: auto;
    padding-top: 22px;
  }
  .project-actions:empty {
    display: none;
  }
  .project-progress-link {
    color: #b9cbe0;
  }
  @media (prefers-reduced-motion: reduce) {
    .project-image-complete::after {
      display: none;
    }
  }
  :global(html[data-motion='paused']) .project-image-complete {
    transition: none;
  }
  :global(html[data-motion='paused']) .project-image-complete::after {
    display: none;
  }
  @media (max-width: 480px) {
    .project-preview-screen {
      padding: 10px;
    }
    .project-preview-bar {
      padding: 10px 12px;
    }
  }
</style>
