---
import type { projects } from '../data/catalog';
interface Props {
  project: (typeof projects)[number];
}
const { project: p } = Astro.props;
---

<article class="project-card reveal">
  <a
    class:list={['project-image', { 'project-image-complete': p.slug === 'orthomax' }]}
    href={`/proyectos/${p.slug}/`}
    tabindex="-1"
    aria-hidden="true"
    ><img
      src={`/assets/${p.image}`}
      alt=""
      width="1440"
      height="900"
      loading="lazy"
      decoding="async"
    /></a
  ><div class="project-info">
    <div>
      <p class="eyebrow">
        {p.sector}
        <span
          class:list={[
            'project-status',
            { 'in-progress': p.status.toLowerCase().includes('desarrollo') },
          ]}><i class="status-dot"></i>{p.status}</span
        >
      </p><h3>
        <a href={`/proyectos/${p.slug}/`}>{p.name}</a>
      </h3>
    </div><a class="circle-link" href={`/proyectos/${p.slug}/`} aria-label={`Ver caso de ${p.name}`}
      >↗</a
    >
  </div><p>{p.intro}</p>
</article>
