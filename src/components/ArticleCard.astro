---
import type { CollectionEntry } from 'astro:content';
interface Props {
  article: CollectionEntry<'insights'>;
  featured?: boolean;
}
const { article, featured = false } = Astro.props;
const a = article.data;
const minutes = Math.max(1, Math.ceil((article.body || '').split(/\s+/).length / 200));
---

<article
  class:list={['article-card', { 'article-featured': featured }]}
  data-filter-item={`${a.title} ${a.description} ${a.category}`}
  data-category={a.category}
>
  <a class="article-art" href={`/soluciones/guias/${article.id}/`} tabindex="-1" aria-hidden="true"
    ><span class="article-art-number">{String(a.order).padStart(2, '0')}</span><span
      class="article-art-line"></span><span class="article-art-label"
      >IDEAS PARA<br />EL SIGUIENTE PASO</span
    ></a
  >
  <div class="article-card-copy">
    <div class="article-meta">
      <span>{a.category}</span><span>{minutes} min de lectura</span>
    </div><h2><a href={`/soluciones/guias/${article.id}/`}>{a.title}</a></h2><p>
      {a.description}
    </p><a class="text-link" href={`/soluciones/guias/${article.id}/`}
      >Leer la guía <span aria-hidden="true">↗</span></a>
  </div>
</article>
