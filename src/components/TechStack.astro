---
import {
  siAstro,
  siReact,
  siTypescript,
  siJavascript,
  siHtml5,
  siNodedotjs,
  siPostgresql,
  siSupabase,
  siGit,
  siSass,
  siFlutter,
  siTauri,
} from 'simple-icons';
const { compact = false } = Astro.props;
const icons = [
  siAstro,
  siReact,
  siTypescript,
  siJavascript,
  siHtml5,
  siNodedotjs,
  siPostgresql,
  siSupabase,
  siGit,
  siSass,
  siFlutter,
  siTauri,
];
const links = [
  'https://astro.build/',
  'https://react.dev/',
  'https://www.typescriptlang.org/',
  'https://developer.mozilla.org/es/docs/Web/JavaScript',
  'https://developer.mozilla.org/es/docs/Web',
  'https://nodejs.org/',
  'https://www.postgresql.org/',
  'https://supabase.com/',
  'https://git-scm.com/',
  'https://sass-lang.com/',
  'https://flutter.dev/',
  'https://v2.tauri.app/',
];
const stack = [
  ['A', 'Astro', 'Contenido rápido e indexable', '#ffb07a'],
  ['⚛', 'React', 'Aplicaciones interactivas', '#72d9f6'],
  ['TS', 'TypeScript', 'Tipos y contratos de interfaz', '#78b6ff'],
  ['JS', 'JavaScript', 'Lógica, eventos y animación', '#f1d46a'],
  ['5', 'HTML + CSS', 'Semántica y diseño adaptable', '#f49eaf'],
  ['N', 'Node.js', 'Pruebas y construcción', '#98dba7'],
  ['PG', 'PostgreSQL', 'Base de datos preparada', '#89b8e0'],
  ['S', 'Supabase', 'Base para acceso privado', '#72deb4'],
  ['Git', 'Git + GitHub', 'Versiones y publicación', '#d2b3ff'],
  ['Sass', 'Sass / SCSS', 'Estilos organizados y reutilizables', '#e5a1c5'],
  ['Flutter', 'Flutter', 'Experiencias móviles multiplataforma', '#6dc8ed'],
  ['Tauri', 'Tauri', 'Aplicaciones de escritorio', '#efd580'],
];
---

<section
  class:list={['section container tech-section', { 'tech-compact': compact }]}
  id="tecnologias"
>
  <div class="section-heading">
    <div>
      <p class="eyebrow">ECOSISTEMA DE DESARROLLO</p><h2>
        Tecnología con<br /><span class="gradient">un propósito claro.</span>
      </h2>
    </div><p>
      Elegimos las herramientas por lo que tu proyecto necesita: velocidad, una buena experiencia y
      una base que pueda crecer.
    </p>
  </div>
  <div class="tech-grid">
    {
      (compact ? stack.slice(0, 6) : stack).map(([, name, description, color], index) => (
        <a
          class="tech-card reveal"
          style={`--tech:${color}`}
          href={links[index]}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`${name}: ${description}. Documentación en otra pestaña`}
        >
          <>
            <span class="tech-monogram" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d={icons[index].path} />
              </svg>
            </span>
            <div>
              <>
                <h3>{name}</h3>
                <p>{description}</p>
              </>
            </div>
          </>
        </a>
      ))
    }
  </div>
  {
    compact && (
      <a class="text-link tech-more" href="/portafolio/#tecnologias">
        Conocer el ecosistema completo ↗
      </a>
    )
  }
  <p class="form-note">
    Las demos públicas guardan ejemplos en el navegador. La conexión a PostgreSQL y Supabase está
    preparada para implementaciones privadas con sus propios accesos.
  </p>
</section>
