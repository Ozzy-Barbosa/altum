---
import Layout from '../layouts/Layout.astro';
import SolutionCard from '../components/SolutionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OrbitArt from '../components/OrbitArt.astro';
import TechStack from '../components/TechStack.astro';
import HeroMotion from '../components/HeroMotion.astro';
import { solutions, projects } from '../data/catalog';
---

<Layout
  title="Páginas web, aplicaciones y software en La Paz, BCS | Altum"
  description="Diseño y desarrollo web en La Paz, BCS. Conoce nuestros proyectos y prueba menús digitales, agendas, tiendas y sistemas para potenciar tu negocio."
>
  <section class="hero container" id="inicio">
    <div class="hero-copy">
      <p class="eyebrow"><span class="status-dot"></span> ESTUDIO DIGITAL · LA PAZ, BCS</p><h1>
        Diseño que inspira.<br /><span class="gradient"
          >Tecnología que<br />impulsa tu negocio.</span
        >
      </h1><p class="lead">
        Creamos páginas web y aplicaciones que comunican el valor de tu negocio, simplifican tu
        operación y abren nuevas oportunidades. Desde La Paz, con una visión a largo plazo.
      </p><div class="actions">
        <a class="button" href="/servicios/">Encuentra tu próximo paso <span>↗</span></a><a
          class="text-link"
          href="/proyectos/">Ver trabajo real →</a
        >
      </div><div class="hero-proof">
        <span>Diseño con identidad</span><span>Desarrollo a medida</span><span
          >Atención cercana</span
        >
      </div>
    </div><div class="hero-system" aria-label="Vista ilustrativa de las soluciones de Altum">
      <OrbitArt /><div class="system-core">
        <img
          src="/assets/logo-altum-symbol-transparent.png"
          alt="Altum"
          width="360"
          height="195"
        /><span>IDEAS EN MOVIMIENTO</span>
      </div><div class="floating-card fc-one">
        <span class="mini-icon mint">▦</span><div>
          <small>OPERACIÓN</small><strong>Todo en su lugar.</strong><div class="mini-bars">
            <i></i><i></i><i></i><i></i><i></i><i></i>
          </div><span class="mini-foot"><i class="status-dot"></i> Tu operación, conectada</span>
        </div>
      </div><div class="floating-card fc-two">
        <span class="mini-icon violet">◷</span><div>
          <small>AGENDA DIGITAL</small><strong>Tu próximo espacio.</strong><span
            class="calendar-days"><i>L</i><i>M</i><i class="selected">M</i><i>J</i><i>V</i></span
          ><span class="mini-foot"
            ><i class="status-dot violet-dot"></i> Cada cita, en su lugar</span
          >
        </div>
      </div><div class="floating-card fc-three">
        <span class="status-dot"></span><span>De la idea a una experiencia real.</span>
      </div><span class="system-caption">DISEÑO + TECNOLOGÍA + PROPÓSITO</span>
    </div>
  </section>
  <div class="brand-strip">
    <div class="container">
      <span>HECHO PARA NEGOCIOS<br />QUE AVANZAN</span><span>Comercio y consumo</span><span
        >Servicios y bienestar</span
      ><span>Turismo y experiencias</span><span>Equipos y operaciones</span>
    </div>
  </div>
  <section class="section container" id="servicios">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / UNA MUESTRA DE LO POSIBLE</p><h2>
          Herramientas que hacen<br /><span class="gradient">avanzar tu día a día.</span>
        </h2>
      </div><p>
        Tres experiencias para explorar cómo puedes presentar tu oferta, organizar citas y entender
        tu operación. El catálogo completo está a un paso.
      </p>
    </div><div class="solutions-grid featured-demos">
      {
        solutions
          .filter((s) => ['menu', 'agenda', 'finanzas'].includes(s.slug))
          .map((solution, index) => <SolutionCard {solution} {index} />)
      }
    </div>
    <div class="catalog-footer">
      <p>Ventas, inventario, clientes, cotizaciones y más.</p><a
        class="button secondary"
        href="/demos/">Explorar las 12 demos ↗</a>
    </div>
  </section>
  <section class="section work-section" id="proyectos">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="eyebrow">02 / DEL CONCEPTO A LA PANTALLA</p><h2>
            Trabajo que<br /><span class="gradient">habla por sí mismo.</span>
          </h2>
        </div><a class="text-link" href="/proyectos/">Todos los proyectos ↗</a>
      </div><div class="projects-grid">
        {projects.slice(0, 2).map((project) => <ProjectCard {project} />)}
      </div>
    </div>
  </section>
  <section class="section container split" id="nosotros">
    <div>
      <p class="eyebrow">03 / TECNOLOGÍA CON ATENCIÓN LOCAL</p><h2>
        Entendemos tu idea.<br />Construimos contigo.
      </h2>
    </div><div class="prose">
      <p>
        Altum es un estudio de diseño y desarrollo web en La Paz, Baja California Sur. Creamos
        presencias digitales y aplicaciones alrededor de una pregunta: ¿qué necesita hacer mejor tu
        negocio?
      </p><p>
        Desde una primera página hasta un sistema de operación, definimos contigo un alcance claro y
        una solución que puedas usar.
      </p><a class="text-link" href="/portafolio/">Conoce el trabajo detrás de Altum ↗</a>
    </div>
  </section>
  <TechStack compact />
  <section class="section container" id="proceso">
    <div class="section-heading">
      <div>
        <p class="eyebrow">04 / UN PROCESO CLARO</p><h2>
          De tu visión<br />a una solución que funciona.
        </h2>
      </div>
    </div><div class="process-grid">
      {
        [
          [
            '01',
            'Comprendemos',
            'Identificamos tus prioridades y el recorrido que necesitas mejorar.',
          ],
          ['02', 'Definimos', 'Acordamos alcance, entregables y una forma clara de comprobarlos.'],
          ['03', 'Construimos', 'Diseñamos, desarrollamos y revisamos cada avance contigo.'],
          ['04', 'Acompañamos', 'Publicamos, explicamos el uso y definimos los siguientes pasos.'],
        ].map(([n, t, d]) => (
          <article class="reveal">
            <>
              <span>{n}</span>
              <h3>{t}</h3>
              <p>{d}</p>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <section class="container callout" id="contacto">
    <div>
      <p class="eyebrow">EMPIEZA POR LO QUE NECESITAS</p><h2>
        ¿Más ventas, mejor atención<br />o una operación más clara?
      </h2><p>Cuéntanos dónde estás y qué quieres mejorar.</p>
    </div><a class="button light" href="/contacto/">Hablemos de tu negocio ↗</a>
  </section>
  <HeroMotion />
</Layout>
