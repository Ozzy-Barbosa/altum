---
import Layout from '../../layouts/Layout.astro';
import { CONTACT } from '../../data/contact';
export function getStaticPaths() {
  return ['propuesta', 'newsletter'].map((tipo) => ({ params: { tipo } }));
}
const newsletter = Astro.params.tipo === 'newsletter';
---

<Layout
  title={newsletter
    ? 'Gracias por tu interés en el newsletter'
    : 'Gracias por compartir tu proyecto'}
  description="Continúa en Altum después de completar el envío de tu solicitud. Contacto directo y siguientes pasos."
  noindex
>
  <section class="container thanks-page">
    <div class="thanks-symbol" aria-hidden="true">↗</div>
    <p class="eyebrow">{newsletter ? 'IDEAS QUE NOS CONECTAN' : 'EL PRIMER PASO ESTÁ DADO'}</p>
    <h1>
      {newsletter ? 'Gracias por querer' : 'Gracias por compartir'}<br /><span class="gradient"
        >{newsletter ? 'seguir aprendiendo.' : 'tu próxima gran idea.'}</span>
    </h1>
    <p class="lead">
      {
        newsletter
          ? 'Revisaremos tu solicitud de suscripción para compartir contigo guías, novedades y comunicaciones de Altum sobre los temas que te interesan.'
          : 'Revisaremos los detalles de tu solicitud y nos pondremos en contacto por el correo que compartiste para conversar sobre tu proyecto.'
      }
    </p>
    <div class="thanks-note">
      <strong>{newsletter ? 'Tú eliges qué recibir.' : 'Sigamos la conversación.'}</strong>
      <p>
        {
          newsletter
            ? 'Puedes solicitar tu baja o cambiar tus intereses en cualquier momento escribiéndonos.'
            : 'Si quieres agregar una referencia o algún detalle, puedes escribirnos directamente.'
        }
        <a
          href={newsletter
            ? `${CONTACT.emailHref}?subject=Baja%20de%20newsletter`
            : CONTACT.emailHref}>{CONTACT.email}</a
        >.
      </p>
      <p class="small-note">
        Si llegaste aquí sin completar el formulario y su verificación de seguridad, tu solicitud
        aún no se ha enviado.
      </p>
    </div>
    <div class="actions">
      <a class="button" href={newsletter ? '/soluciones/' : '/proyectos/'}
        >{newsletter ? 'Explorar las guías' : 'Conocer nuestro trabajo'}
        <span aria-hidden="true">↗</span></a
      ><a class="text-link" href="/">Volver a Inicio</a>
    </div>
  </section>
</Layout>

<style>
  .thanks-page {
    max-width: 900px;
    text-align: center;
    padding-block: 80px 100px;
  }
  .thanks-symbol {
    display: grid;
    place-items: center;
    width: 75px;
    height: 75px;
    margin: 0 auto 30px;
    border-radius: 23px;
    border: 1px solid #28d2e773;
    background: linear-gradient(145deg, #28d2e71a, #9276ff1a);
    color: var(--cyan);
    font-size: 2rem;
  }
  h1 {
    font-size: clamp(2.5rem, 5vw, 4.6rem);
  }
  .lead {
    margin-inline: auto;
    max-width: 730px;
    font-size: 1rem;
  }
  .thanks-note {
    padding: 27px;
    margin-top: 35px;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 20px;
    text-align: left;
  }
  .thanks-note p {
    font-size: 0.88rem;
    margin-top: 8px;
  }
  .thanks-note a {
    color: var(--cyan);
    overflow-wrap: anywhere;
  }
  .thanks-note .small-note {
    font-size: 0.73rem;
    margin-top: 16px;
  }
  .actions {
    justify-content: center;
  }
</style>
