---
import Layout from '../../layouts/Layout.astro';
import { services } from '../../data/catalog';
import FilterCatalog from '../../components/FilterCatalog.astro';
import ServiceIcon from '../../components/ServiceIcon.astro';
import { servicePresentation } from '../../data/service-presentation';
---

<Layout
  title="Servicios digitales, redes y tecnología en La Paz"
  description="Diseño web, software, redes Wi-Fi, identidad visual, marketing y bases de datos para negocios de La Paz, BCS. Explora servicios y define tu proyecto."
>
  <section class="container page-hero">
    <p class="eyebrow">ALTUM / SERVICIOS</p><h1>
      Conecta tu negocio.<br /><span class="gradient">En todos sus puntos.</span>
    </h1><p class="lead">
      Tu marca, tus herramientas y tu conexión forman parte de la misma experiencia. Empezamos por
      lo que necesitas mejorar.
    </p><div class="actions">
      <a class="button" href="/contacto/">Cuéntanos qué necesitas ↗</a><a
        class="text-link"
        href="/demos/">Explorar aplicaciones →</a
      >
    </div>
  </section>
  <section class="container compact-section">
    <FilterCatalog
      categories={[...new Set(Object.values(servicePresentation).map((s) => s.category))]}
      label="Encuentra el servicio que necesitas"
      placeholder="Busca: página, redes, identidad, datos…"
      total={services.length}
      noun="servicios"
    >
      <div class="service-grid friendly-services">
        {
          services.map((s) => (
            <article
              class="service-card reveal"
              data-filter-item={`${s.short} ${s.name} ${s.intro} ${servicePresentation[s.slug].result} ${servicePresentation[s.slug].category}`}
              data-category={servicePresentation[s.slug].category}
            >
              <>
                <div class="service-card-top">
                  <>
                    <span class="service-icon">
                      <ServiceIcon name={servicePresentation[s.slug].icon} />
                    </span>
                    <span class="tag">{servicePresentation[s.slug].category}</span>
                  </>
                </div>
                <h2>
                  <a href={`/servicios/${s.slug}/`}>{s.short}</a>
                </h2>
                <p>{servicePresentation[s.slug].result}</p>
                <p class="service-includes">
                  <strong>Podemos ayudarte con</strong>
                  {s.deliverables.slice(0, 2).join(' · ')}
                </p>
                <a class="text-link" href={`/servicios/${s.slug}/`}>
                  Conocer el servicio ↗
                </a>
              </>
            </article>
          ))
        }
      </div></FilterCatalog
    >
  </section>
  <section class="container callout">
    <div>
      <h2>El primer paso es entenderlo.</h2><p>
        Definimos prioridades, entregables y costos externos antes de comenzar. Cada servicio puede
        contratarse con su propio alcance.
      </p>
    </div><a class="button" href="/preguntas-frecuentes/">Resolver mis dudas ↗</a>
  </section>
</Layout>
