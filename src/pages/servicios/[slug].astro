---
import Layout from '../../layouts/Layout.astro';
import { services, site } from '../../data/catalog';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props;
---

<Layout
  title={s.name}
  description={s.text}
  schema={{
    '@type': 'Service',
    name: s.name,
    description: s.intro,
    provider: { '@id': site.origin + '/#business' },
    areaServed: { '@type': 'City', name: 'La Paz, Baja California Sur' },
  }}
  ><section class="page-hero container">
    <div class="breadcrumb">
      <a href="/soluciones/">Servicios</a><span>/</span><span>{s.short}</span>
    </div><p class="eyebrow">ALTUM / LA PAZ, BCS</p><h1>{s.name}</h1><p class="lead">
      {s.intro}
    </p><div class="actions">
      <a class="button" href="/contacto/">Hablemos de tu proyecto ↗</a><a
        class="text-link"
        href={`/demos/${s.demo}/`}>Ver una demostración →</a
      >
    </div>
  </section><section class="container split compact-section">
    <div class="prose">
      <h2>Una solución que parte de tu operación.</h2><p>{s.text}</p><p>{s.problem}</p>
    </div><div class="contact-card">
      <h2>Qué podemos incluir</h2><ul class="check-list">
        {s.deliverables.map((d) => <li>{d}</li>)}
      </ul><p class="form-note">
        El alcance, los tiempos y la inversión se acuerdan según las necesidades de cada proyecto.
      </p>
    </div>
  </section>
  {
    s.slug === 'dashboards-inventario-la-paz' && (
      <section class="container section">
        <>
          <div class="section-heading">
            <>
              <div>
                <>
                  <p class="eyebrow">EL PANEL ADECUADO PARA CADA DECISIÓN</p>
                  <h2>
                    Distintos datos.
                    <br />
                    Distintas preguntas.
                  </h2>
                </>
              </div>
              <p>
                Un dashboard debe permitir entender el indicador y consultar los registros que lo
                explican. Estas demos muestran cuatro enfoques.
              </p>
            </>
          </div>
          <div class="table-scroll">
            <table class="data-table">
              <>
                <caption>Tipos de dashboard para negocios</caption>
                <thead>
                  <tr>
                    <>
                      <th>Panel</th>
                      <th>Qué permite revisar</th>
                      <th>Ejemplo interactivo</th>
                    </>
                  </tr>
                </thead>
                <tbody>
                  {[
                    [
                      'Financiero',
                      'Ingresos, gastos, flujo neto mensual y uso del presupuesto.',
                      'finanzas',
                    ],
                    [
                      'Comercial',
                      'Oportunidades abiertas, valor potencial y siguientes seguimientos.',
                      'crm',
                    ],
                    [
                      'Inventario',
                      'Existencias, productos bajo mínimos y movimientos del almacén.',
                      'inventario',
                    ],
                    [
                      'Operación de servicios',
                      'Órdenes activas, prioridades, responsables y avance hasta la entrega.',
                      'servicios',
                    ],
                  ].map(([label, description, slug]) => (
                    <tr>
                      <td>
                        <strong>{label}</strong>
                      </td>
                      <td>{description}</td>
                      <td>
                        <a class="text-link" href={`/demos/${slug}/`}>
                          Probar panel ↗
                        </a>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </>
            </table>
          </div>
          <p class="form-note">
            Los indicadores de estas demos se calculan con información ficticia. Para una
            implementación real acordamos fuentes de datos, periodos, permisos y reglas del negocio.
          </p>
        </>
      </section>
    )
  }
  <section class="container section split">
    <div><p class="eyebrow">ANTES DE EMPEZAR</p><h2>Preguntas frecuentes.</h2></div><div>
      {
        s.faq.map(([q, a]) => (
          <details>
            <>
              <summary>{q}</summary>
              <p>{a}</p>
            </>
          </details>
        ))
      }
    </div>
  </section><section class="container callout">
    <div>
      <h2>Conoce cómo trabajamos.</h2><p>
        Revisa nuestros proyectos y cuéntanos qué necesita tu negocio.
      </p>
    </div><a class="button" href="/proyectos/">Ver casos de estudio ↗</a>
  </section></Layout
>
