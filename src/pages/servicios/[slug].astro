---
import Layout from '../../layouts/Layout.astro';
import { services, site } from '../../data/catalog';
export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service: s } = Astro.props;
---

<Layout
  title={s.name}
  description={s.text}
  schema={{
    '@type': 'Service',
    name: s.name,
    description: s.intro,
    provider: { '@id': site.origin + '/#business' },
    areaServed: { '@type': 'City', name: 'La Paz, Baja California Sur' },
  }}
  ><section class="page-hero container">
    <div class="breadcrumb">
      <a href="/soluciones/">Servicios</a><span>/</span><span>{s.short}</span>
    </div><p class="eyebrow">ALTUM / LA PAZ, BCS</p><h1>{s.name}</h1><p class="lead">
      {s.intro}
    </p><div class="actions">
      <a class="button" href="/contacto/">Hablemos de tu proyecto ↗</a><a
        class="text-link"
        href={`/demos/${s.demo}/`}>Ver una demostración →</a
      >
    </div>
  </section><section class="container split compact-section">
    <div class="prose">
      <h2>Una solución que parte de tu operación.</h2><p>{s.text}</p><p>{s.problem}</p>
    </div><div class="contact-card">
      <h2>Qué podemos incluir</h2><ul class="check-list">
        {s.deliverables.map((d) => <li>{d}</li>)}
      </ul><p class="form-note">
        El alcance, los tiempos y la inversión se acuerdan según las necesidades de cada proyecto.
      </p>
    </div>
  </section><section class="container section split">
    <div><p class="eyebrow">ANTES DE EMPEZAR</p><h2>Preguntas frecuentes.</h2></div><div>
      {
        s.faq.map(([q, a]) => (
          <details>
            <>
              <summary>{q}</summary>
              <p>{a}</p>
            </>
          </details>
        ))
      }
    </div>
  </section><section class="container callout">
    <div>
      <h2>Conoce cómo trabajamos.</h2><p>
        Revisa nuestros proyectos y cuéntanos qué necesita tu negocio.
      </p>
    </div><a class="button" href="/proyectos/">Ver casos de estudio ↗</a>
  </section></Layout
>
