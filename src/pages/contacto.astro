---
import Layout from '../layouts/Layout.astro';
import { solutions, site, services } from '../data/catalog';
---

<Layout
  title="Contacto · Desarrollo web en La Paz"
  description="Cuéntanos qué necesita tu negocio. Contacta a Altum en La Paz para diseño web, tiendas en línea, menús digitales y desarrollo de aplicaciones."
  ><section class="page-hero container">
    <p class="eyebrow">CONSTRUYAMOS EL SIGUIENTE PASO</p><h1>
      Tu idea empieza<br /><span class="gradient">con una conversación.</span>
    </h1><p class="lead">
      Cuéntanos qué haces y qué quieres mejorar. Definimos juntos la solución, el alcance y la
      inversión.
    </p>
  </section><section class="container compact-section contact-grid">
    <div>
      <div class="contact-card">
        <p class="eyebrow">CONTACTO DIRECTO</p><h2>Hablemos por WhatsApp.</h2><p>
          Si prefieres explicarnos tu idea directamente, aquí estamos.
        </p><a class="button" href={site.whatsapp} target="_blank" rel="noopener noreferrer"
          >{site.phone} ↗</a
        >
      </div><div class="prose" style="margin-top:30px">
        <h3>Antes de construir</h3><p>
          Revisamos tu objetivo, la información disponible y las funciones necesarias. Te
          presentamos una propuesta con entregables y servicios externos identificados.
        </p><p>Atención desde La Paz, Baja California Sur.</p>
      </div>
    </div><form id="brief" class="contact-card">
      <h2>Prepara tu solicitud.</h2><p style="margin-bottom:25px">
        Este formulario organiza un mensaje. Tú revisas y envías la solicitud desde WhatsApp.
      </p><div class="form-grid">
        <label class="field"
          >Tu nombre *<input name="name" required maxlength="80" autocomplete="name" /></label
        ><label class="field"
          >Negocio o marca *<input
            name="business"
            required
            maxlength="100"
            autocomplete="organization"
          /></label
        ><label class="field full"
          >¿Qué necesitas? *<select name="solution" id="solution" required
            ><option value="">Selecciona una opción</option><option value="web"
              >Página web profesional</option
            >{solutions.map((s) => <option value={s.slug}>{s.label}</option>)}{
              services.slice(6).map((s) => <option value={s.slug}>{s.short}</option>)
            }<option value="other">Otro proyecto / necesito orientación</option></select
          ></label
        ><label class="field full"
          >¿Qué quieres mejorar? *<textarea
            name="goal"
            required
            maxlength="1500"
            placeholder="Por ejemplo: presentar mis servicios y recibir solicitudes de citas."
          ></textarea></label
        >
      </div><details>
        <summary>Agregar detalles de alcance (opcional)</summary><div
          class="form-grid"
          style="margin-top:20px"
        >
          <label class="field full"
            >Sitio o red actual<input
              name="current"
              maxlength="250"
              placeholder="Tu página o perfil actual"
            /></label
          ><label class="field"
            >Inversión estimada<select name="budget"
              ><option>Por definir</option><option>$2,500–$5,000 MXN</option><option
                >$5,000–$15,000 MXN</option
              ><option>$15,000–$40,000 MXN</option><option>Más de $40,000 MXN</option></select
            ></label
          ><label class="field"
            >Fecha ideal<select name="timeline"
              ><option>Por definir</option><option>Lo antes posible</option><option
                >En 2–4 semanas</option
              ><option>En 1–3 meses</option></select
            ></label
          >
        </div>
      </details><button class="button" style="margin-top:25px" type="submit"
        >Preparar mensaje en WhatsApp ↗</button
      ><p class="form-note">
        Altum no guarda este formulario en su base de datos. Al continuar, compartirás el mensaje
        con WhatsApp. <a class="text-link" href="/privacidad/">Ver privacidad</a>.
      </p><p id="brief-status" role="status"></p>
    </form>
  </section><script>
    const form = document.getElementById('brief') as HTMLFormElement;
    const select = document.getElementById('solution') as HTMLSelectElement;
    const param = new URLSearchParams(location.search).get('solucion');
    if (param && Array.from(select.options).some((o) => o.value === param)) select.value = param;
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const message = [
        'Hola Altum, quiero mejorar mi negocio.',
        `Nombre: ${data.get('name')}`,
        `Negocio: ${data.get('business')}`,
        `Solución: ${select.selectedOptions[0].textContent}`,
        `Objetivo: ${data.get('goal')}`,
        `Sitio o red: ${data.get('current') || 'Por definir'}`,
        `Inversión: ${data.get('budget')}`,
        `Fecha: ${data.get('timeline')}`,
      ].join('\n');
      const link = document.createElement('a');
      link.href = `https://wa.me/526122125198?text=${encodeURIComponent(message)}`;
      link.target = '_blank';
      link.rel = 'noopener noreferrer';
      link.click();
      const status = document.getElementById('brief-status');
      if (status) status.textContent = 'Mensaje preparado. Revísalo y envíalo en WhatsApp.';
    });
  </script></Layout
>
