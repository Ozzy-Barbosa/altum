---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import SocialLinks from '../components/SocialLinks.astro';
import WhatsAppBrief from '../components/WhatsAppBrief.astro';
import { projectTypes } from '../data/project-types';
import { CONTACT } from '../data/contact';
import '../styles/contact.css';
---

<Layout
  title="Cuéntanos tu proyecto · Contacto Altum La Paz"
  description="Solicita una propuesta de diseño web, tienda en línea o software a medida en La Paz. Escríbenos a altumlapaz@gmail.com y cuéntanos qué necesita tu negocio."
>
  <section class="page-hero container contact-hero">
    <div>
      <p class="eyebrow"><span class="status-dot"></span> UNA IDEA. MUCHAS POSIBILIDADES.</p>
      <h1>Lo que imaginas,<br /><span class="gradient">empieza aquí.</span></h1>
      <p class="lead">
        Cuéntanos qué quieres crear. Te ayudamos a darle forma con diseño, tecnología y un siguiente
        paso claro.
      </p>
      <div class="contact-jump-links">
        <a href="#brief" class="text-link">Propuesta por correo <span aria-hidden="true">↓</span></a
        ><a href="#whatsapp" class="text-link"
          >Consulta por WhatsApp <span aria-hidden="true">↓</span></a
        ><a href="#newsletter-contacto" class="text-link"
          >Recibir ideas y novedades <span aria-hidden="true">↓</span></a
        >
      </div>
    </div>
    <div class="contact-signal" aria-hidden="true">
      <span class="signal-orbit orbit-one"></span><span class="signal-orbit orbit-two"></span><div
        class="signal-envelope"
      >
        <svg viewBox="0 0 80 60" fill="none"
          ><rect x="4" y="6" width="72" height="48" rx="10"></rect><path
            d="m5 12 35 25 35-25M6 49l23-21m45 21L51 28"></path></svg
        >
      </div><span class="signal-label">DE TU IDEA AL SIGUIENTE PASO</span>
    </div>
  </section>
  <section class="container proposal-layout compact-section" aria-label="Solicitud de proyecto">
    <aside class="proposal-aside">
      <div class="direct-contact">
        <p class="eyebrow">HABLEMOS DIRECTO</p><h2>Una conversación.<br />Un buen comienzo.</h2><p>
          ¿Ya tienes un brief o prefieres escribirnos? Estamos a un mensaje de distancia.
        </p>
        <a class="contact-channel" href={CONTACT.emailHref}
          ><span class="channel-icon" aria-hidden="true">@</span><span
            ><small>CORREO DE ALTUM</small><strong>{CONTACT.email}</strong></span
          ><span aria-hidden="true">↗</span></a
        >
        <a class="contact-channel" href={CONTACT.whatsapp} target="_blank" rel="noopener noreferrer"
          ><span class="channel-icon" aria-hidden="true">↗</span><span
            ><small>WHATSAPP</small><strong>{CONTACT.phone}</strong></span
          ><span aria-hidden="true">↗</span></a
        >
        <SocialLinks /><p class="contact-location">
          Desde La Paz, Baja California Sur.<br />Conectamos contigo donde estés.
        </p>
      </div>
      <div class="what-next">
        <p class="eyebrow">¿QUÉ SIGUE DESPUÉS?</p><ol>
          <li>
            <span>01</span><div>
              <strong>Leemos tu idea</strong><p>
                Revisamos el objetivo y los detalles que compartas.
              </p>
            </div>
          </li>
          <li>
            <span>02</span><div>
              <strong>Aclaramos lo importante</strong><p>
                Te contactamos para entender alcance, prioridades y tiempos.
              </p>
            </div>
          </li>
          <li>
            <span>03</span><div>
              <strong>Definimos una propuesta</strong><p>
                Con entregables, inversión y siguientes pasos.
              </p>
            </div>
          </li>
        </ol>
      </div>
    </aside>
    <form
      id="brief"
      class="proposal-form"
      action={`https://formsubmit.co/${CONTACT.email}`}
      method="POST"
      data-email-form
      aria-describedby="brief-help"
    >
      <input type="hidden" name="_subject" value="[Altum Propuesta] Nueva solicitud de proyecto" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://www.altumlapaz.com/gracias/propuesta/" />
      <input type="hidden" name="Origen" value="Altum · Formulario de proyecto" />
      <input
        type="hidden"
        name="Aviso de privacidad"
        value="https://www.altumlapaz.com/privacidad/ · 2026-09-18"
      />
      <input type="hidden" name="Fecha de solicitud" value="" data-submission-date />
      <input type="hidden" name="Tipo de proyecto" value="" id="project-label" />
      <div class="form-trap" aria-hidden="true">
        <label
          >Deja este campo vacío<input
            type="text"
            name="_honey"
            tabindex="-1"
            autocomplete="off"
          /></label
        >
      </div>
      <div class="proposal-heading">
        <span class="proposal-mark" aria-hidden="true">↗</span><p class="eyebrow">
          HAGÁMOSLO POSIBLE
        </p><h2>Cuéntanos tu proyecto.</h2><p id="brief-help">
          No necesitas tenerlo todo resuelto. Empieza con lo esencial; los campos con * son
          obligatorios.
        </p>
      </div>
      <fieldset class="proposal-block">
        <legend><span>01</span> Un poco sobre ti</legend><div class="form-grid">
          <label class="field"
            >Tu nombre *<input
              name="name"
              required
              maxlength="80"
              autocomplete="name"
              placeholder="¿Cómo te llamas?"
            /></label
          >
          <label class="field"
            >Correo electrónico *<input
              name="email"
              type="email"
              required
              maxlength="254"
              autocomplete="email"
              placeholder="tu@correo.com"
            /></label
          >
          <label class="field"
            >Negocio o marca (opcional)<input
              name="Negocio"
              maxlength="100"
              autocomplete="organization"
              placeholder="Nombre de tu negocio"
            /></label
          >
          <label class="field"
            >WhatsApp (opcional)<input
              name="Telefono"
              type="tel"
              maxlength="30"
              autocomplete="tel"
              placeholder="Incluye tu lada"
            /></label
          >
        </div>
      </fieldset>
      <fieldset class="proposal-block">
        <legend><span>02</span> Lo que te gustaría crear</legend><div class="form-grid">
          <label class="field full"
            >Tipo de proyecto *<select name="solution" id="solution" required
              ><option value="">Elige lo que más se acerque a tu idea</option>{
                projectTypes.map((p) => <option value={p.value}>{p.label}</option>)
              }</select
            ></label
          >
          <label class="field full"
            >Tu idea y el objetivo principal *<textarea
              name="Objetivo"
              id="project-goal"
              required
              minlength="15"
              maxlength="3000"
              rows="5"
              placeholder="Por ejemplo: quiero una página para mostrar mis servicios, recibir solicitudes y facilitar las citas de mis clientes."
              aria-describedby="goal-help"></textarea><small id="goal-help"
              >Cuéntanos qué necesitas y qué te gustaría mejorar. Entre 15 y 3,000 caracteres.</small
            ></label
          >
        </div>
      </fieldset>
      <details class="scope-details">
        <summary
          ><span
            ><strong>¿Ya tienes algo en mente?</strong><small
              >Agrega funciones, presupuesto y fechas (opcional).</small
            ></span
          ><span class="details-plus" aria-hidden="true">+</span></summary
        ><div class="scope-content">
          <fieldset class="feature-options">
            <legend>Funciones que te interesan</legend><div>
              {
                [
                  'Catálogo de productos',
                  'Reservas y citas',
                  'Pagos en línea',
                  'Panel de administración',
                  'Automatizaciones',
                  'Todavía no lo sé',
                ].map((feature, i) => (
                  <label class="feature-option">
                    <>
                      <input type="checkbox" name={`Funcion ${i + 1}`} value={feature} />
                      <span>{feature}</span>
                    </>
                  </label>
                ))
              }
            </div>
          </fieldset>
          <div class="form-grid">
            <label class="field full"
              >Sitio, redes o referencias<input
                name="Referencias"
                maxlength="500"
                placeholder="Enlace a tu marca o a un sitio que te inspire"
              /></label
            >
            <label class="field"
              >Inversión aproximada<select name="Presupuesto"
                ><option>Por definir</option><option>$2,500–$5,000 MXN</option><option
                  >$5,000–$15,000 MXN</option
                ><option>$15,000–$40,000 MXN</option><option>Más de $40,000 MXN</option></select
              ></label
            >
            <label class="field"
              >¿Cuándo te gustaría empezar?<select name="Plazo"
                ><option>Por definir</option><option>Lo antes posible</option><option
                  >En 2–4 semanas</option
                ><option>En 1–3 meses</option><option>Estoy explorando opciones</option></select
              ></label
            >
          </div>
        </div>
      </details>
      <div class="proposal-consent">
        <label class="consent-row"
          ><input
            type="checkbox"
            name="Consentimiento de contacto"
            value="Acepto que Altum use mis datos para responder esta solicitud y dar seguimiento al proyecto."
            required
          /><span
            >Acepto que Altum use mis datos para responder mi solicitud y dar seguimiento a mi
            proyecto. He leído el <a class="text-link" href="/privacidad/#contacto"
              >aviso de privacidad</a
            >. *</span
          ></label
        ><p>Esta solicitud no te suscribe al newsletter. Puedes hacerlo por separado más abajo.</p>
      </div>
      <button class="button proposal-submit" type="submit"
        ><span>Enviar solicitud por correo</span><span aria-hidden="true">↗</span></button
      >
      <p class="proposal-send-note">
        Tu solicitud se dirige a <strong>{CONTACT.email}</strong>. Al continuar, completa la
        verificación de envío en la siguiente pantalla.
      </p>
      <p class="email-form-status" role="status" aria-live="polite" data-form-status></p>
      <noscript
        ><p class="form-note">
          Puedes enviar este formulario sin JavaScript. Completa todos los campos obligatorios y la
          verificación de envío.
        </p></noscript
      >
    </form>
  </section>
  <WhatsAppBrief />
  <Newsletter id="newsletter-contacto" />
  <script>
    import { enhanceEmailForms } from '../lib/email-forms';
    enhanceEmailForms();
    const select = document.querySelector<HTMLSelectElement>('#solution');
    const projectLabel = document.querySelector<HTMLInputElement>('#project-label');
    const param = new URLSearchParams(location.search).get('solucion');
    if (select) {
      if (param && Array.from(select.options).some((o) => o.value === param)) select.value = param;
      const syncLabel = () => {
        if (projectLabel) projectLabel.value = select.selectedOptions[0]?.textContent || '';
      };
      syncLabel();
      select.addEventListener('change', syncLabel);
      select.form?.addEventListener('submit', syncLabel);
    }
  </script>
</Layout>
