---
import Layout from '../../layouts/Layout.astro';
import { solutions, site } from '../../data/catalog';
import { specifications } from '../../data/specifications';
export function getStaticPaths() {
  return solutions.map((solution) => ({ params: { slug: solution.slug }, props: { solution } }));
}
const { solution: s } = Astro.props;
const [problem, flow, example] = specifications[s.slug];
---

<Layout
  title={`${s.label} para negocios | Altum`}
  description={s.description}
  schema={{
    '@type': 'Service',
    name: s.label,
    description: s.description,
    provider: { '@id': site.origin + '/#business' },
    areaServed: 'La Paz, Baja California Sur',
  }}
  ><section class="page-hero container">
    <div class="breadcrumb">
      <a href="/demos/">Demos</a><span>/</span><span>{s.name}</span>
    </div><p class="eyebrow">FICHA DE APLICACIÓN / {s.category}</p><h1>{s.headline}</h1><p
      class="lead"
    >
      {s.description}
    </p><div class="actions">
      <a class="button" href={`/demos/${s.slug}/`}>Probar la demo ↗</a><a
        class="text-link"
        href={`/contacto/?solucion=${s.slug}`}>Quiero algo así para mi negocio →</a
      >
    </div>
  </section><section class="container compact-section" id="especificaciones">
    <div class="section-heading">
      <div>
        <p class="eyebrow">ANTES DE ELEGIR UNA HERRAMIENTA</p><h2>
          Qué resuelve.<br /><span class="gradient">Cómo funciona.</span>
        </h2>
      </div><p>Una explicación práctica para reconocer si esta solución encaja con tu día a día.</p>
    </div><div class="spec-grid">
      {
        [
          ['01 / LA NECESIDAD', '¿Te pasa esto?', problem],
          ['02 / EL RECORRIDO', 'Así se utiliza.', flow],
          ['03 / UN CASO COTIDIANO', 'Llévalo a tu realidad.', example],
        ].map(([n, t, d]) => (
          <article class="spec-card">
            <>
              <p class="eyebrow">{n}</p>
              <h3>{t}</h3>
              <p>{d}</p>
            </>
          </article>
        ))
      }
    </div><div class="actions">
      <a class="text-link" href={`/demos/${s.slug}/`}>Ahora pruébalo tú ↗</a><a
        class="text-link"
        href="/preguntas-frecuentes/">Dudas sobre implementación →</a
      >
    </div>
  </section><section class="container split section">
    <div>
      <h2>Así comienza<br />tu solución.</h2><p style="margin-top:24px">{s.audience}</p><ul
        class="check-list"
      >
        {s.features.map((f) => <li>{f}</li>)}
      </ul>
    </div><div>
      <div class="contact-card">
        <p class="eyebrow">PRUÉBALO ANTES DE IMAGINARLO</p><h2>Una demo, un recorrido real.</h2><p>
          {s.demo}
        </p><a class="button secondary" href={`/demos/${s.slug}/`}>Abrir {s.name} →</a>
      </div><p class="note" style="margin-top:20px">{s.boundary}</p>
    </div>
  </section><section class="container section split">
    <div><p class="eyebrow">DE EJEMPLO A TU NEGOCIO</p><h2>Tu marca.<br />Tus reglas.</h2></div><div
      class="prose"
    >
      <p>
        La demostración utiliza información ficticia. Para tu implementación configuramos identidad,
        catálogo, usuarios y reglas de operación. Confirmamos contigo los servicios externos
        necesarios y su costo antes de contratarlos.
      </p><h3>Posibles siguientes etapas</h3><ul>{s.next.map((n) => <li>{n}</li>)}</ul><a
        class="text-link"
        href={`/contacto/?solucion=${s.slug}`}>Definamos tu alcance ↗</a
      >
    </div>
  </section></Layout
>
