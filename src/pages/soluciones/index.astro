---
import Layout from '../../layouts/Layout.astro';
import FilterCatalog from '../../components/FilterCatalog.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { site } from '../../data/catalog';
const articles = (await getCollection('insights', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Layout
  title="Soluciones: guías de tecnología y crecimiento para negocios"
  description="Ideas prácticas para digitalizar tu negocio: presencia web, automatización, dashboards, comercio y sistemas. Aprende a elegir el siguiente paso con Altum."
  schema={{
    '@type': 'Blog',
    name: 'Soluciones · Ideas para tu negocio',
    url: site.origin + '/soluciones/',
    inLanguage: 'es-MX',
    publisher: { '@id': site.origin + '/#business' },
    blogPost: articles.map((a) => ({
      '@type': 'BlogPosting',
      headline: a.data.title,
      url: `${site.origin}/soluciones/guias/${a.id}/`,
    })),
  }}
  ><section class="page-hero container editorial-hero">
    <p class="eyebrow">SOLUCIONES / IDEAS PARA TU NEGOCIO</p><h1>
      El siguiente paso<br />empieza con <span class="gradient">una buena decisión.</span>
    </h1><p class="lead">
      Guías para entender la tecnología, reconocer oportunidades y elegir mejoras que tengan sentido
      para tu negocio.
    </p>
    <div class="editorial-note">
      <span class="status-dot"></span> Información práctica. Decisiones con propósito.
    </div>
  </section><section class="container compact-section">
    <FilterCatalog
      categories={[...new Set(articles.map((a) => a.data.category))]}
      label="¿Sobre qué te gustaría aprender?"
      placeholder="Busca: digitalizar, web, automatizar, datos…"
      total={articles.length}
      noun="guías"
    >
      <div class="article-grid">{articles.map((article) => <ArticleCard {article} />)}</div>
    </FilterCatalog>
  </section><section class="container callout">
    <div>
      <p class="eyebrow">DE LA IDEA A LA PRÁCTICA</p><h2>
        Ya conoces el porqué.<br />Explora el cómo.
      </h2><p>
        Consulta los servicios para definir un proyecto o prueba las aplicaciones con datos de
        ejemplo.
      </p>
    </div><div class="actions">
      <a class="button" href="/servicios/">Ver servicios ↗</a><a class="text-link" href="/demos/"
        >Probar demos →</a>
    </div>
  </section></Layout
>
